{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/general",
  "providers": {
    "opencode": {
      "models": {
        "general": {
          "modelID": "deepseek-v4.1-flash-free",
          "name": "General (DeepSeek V4.1 Flash Free)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true
          },
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    },
    "ollama-local": {
      "name": "Ollama (adaptado)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11435/v1",
        "headerTimeout": 600000,
        "chunkTimeout": 900000
      },
      "models": {
        "ediciones-chicas": {
          "modelID": "qwen2.5-coder:7b-opencode",
          "name": "Ediciones chicas (Qwen2.5 Coder 7B)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true
          },
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "body": {
            "temperature": 0.2,
            "top_p": 0.9
          }
        },
        "coder-30b": {
          "modelID": "qwen3-coder:30b",
          "name": "Qwen3 Coder 30B-A3B",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true
          },
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "body": {
            "temperature": 0.2,
            "top_p": 0.8,
            "top_k": 20,
            "num_batch": 3072,
            "num_thread": 6
          }
        }
      }
    },
    "ollama": {
      "models": {
        "qwen2.5-coder:7b": {
          "disabled": true
        },
        "qwen2.5-coder:7b-opencode": {
          "disabled": true
        }
      }
    }
  }
}
